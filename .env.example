# ---------------------------------------------------------------------------
# Copy to .env and fill in real values.  NEVER commit .env.
#   cp .env.example .env
#
# Precedence: config/base.yaml  <  config/<profile>.yaml  <  these env vars.
# Nested keys use a double underscore:  TB_DATABASE__PASSWORD -> database.password
# ---------------------------------------------------------------------------

# Which profile to load from config/: development | paper | production
TB_PROFILE=development

# --- Database -------------------------------------------------------------
TB_DATABASE__HOST=127.0.0.1
TB_DATABASE__PORT=5432
TB_DATABASE__NAME=trading_bot_dev
TB_DATABASE__USER=trading_bot
TB_DATABASE__PASSWORD=change_me_locally

# --- Exchange credentials -------------------------------------------------
# NOT needed for Phase 0-16: all market data used by this project is public.
# Only required if live execution is ever enabled (Phase 17).
# The API key MUST NOT have withdrawal permission. Enable IP allow-listing.
TB_EXCHANGE__API_KEY=
TB_EXCHANGE__API_SECRET=

# --- Live trading safety --------------------------------------------------
# Live execution stays disabled unless ALL of the following hold:
#   1. TB_PROFILE=production
#   2. TB_EXECUTION__LIVE_ENABLED=true
#   3. TB_EXECUTION__LIVE_CONFIRMATION_PHRASE is set
# Leave these alone until the platform has been validated in paper mode.
TB_EXECUTION__LIVE_ENABLED=false
TB_EXECUTION__LIVE_CONFIRMATION_PHRASE=

# --- Optional overrides ---------------------------------------------------
# TB_LOGGING__LEVEL=DEBUG
# TB_API__PORT=8000
